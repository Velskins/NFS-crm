{% extends 'base.html.twig' %}
{% block title %}Nouveau RDV — {{ client.firstName }} {{ client.lastName }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/detail.css') }}">
{% endblock %}

{% block body %}
    <div class="detail-header">
        <div class="detail-header-left">
            <a href="{{ path('app_client_show', {'id': client.id}) }}" class="detail-back" title="Retour">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            </a>
            <div>
                <h1 class="detail-title">Nouveau rendez-vous</h1>
                <p class="detail-subtitle">Client : {{ client.firstName }} {{ client.lastName }} — {{ client.companyName }}</p>
            </div>
        </div>
    </div>

    <div class="detail-grid detail-grid--full">

                <h2 class="detail-section-title">Informations du rendez-vous</h2>

                {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'data-turbo': 'false'}}) }}

                {% if form.vars.submitted and not form.vars.valid %}
                    <div class="alert alert-danger" style="margin-bottom: var(--space-4);">
                        Veuillez corriger les erreurs ci-dessous.
                    </div>
                {% endif %}
                {{ form_errors(form) }}

                <div class="rdv-form-grid">

                    <div class="form-group">
                        {{ form_label(form.scheduleAt) }}
                        {{ form_widget(form.scheduleAt, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.scheduleAt) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.subject) }}
                        {{ form_widget(form.subject, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.subject) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.note) }}
                        {{ form_widget(form.note, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                        {{ form_errors(form.note) }}
                    </div>

                </div>

                <div class="rdv-form-actions">
                    <a href="{{ path('app_client_show', {'id': client.id}) }}" class="btn btn-secondary">Annuler</a>
                    <button type="submit" class="btn btn-primary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;vertical-align:middle;margin-right:6px;">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                        Confirmer le rendez-vous
                    </button>
                </div>

                {{ form_end(form) }}
        </div>
{% endblock %}
