{% extends 'base.html.twig' %}

{% block title %}Tableau de bord — Sphera{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/dashboard.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/project.css') }}">
{% endblock %}

{% block body %}

    {# ══════════════════════════════════════════════════════
       KPI CARDS (3 colonnes)
       ══════════════════════════════════════════════════════ #}
    <div class="dash-kpis">

        {# KPI 1 — Revenu annuel #}
        <div class="dash-kpi">
            <div class="dash-kpi-inner">
                <div class="dash-kpi-ring">
                    {# Cercle SVG — circumference = 2π × 34 ≈ 213.6 #}
                    {% set circumference = 213.6 %}
                    {% set offset = circumference * (1 - revenue_percent / 100) %}
                    <svg viewBox="0 0 80 80">
                        <circle class="dash-kpi-ring-bg" cx="40" cy="40" r="34"/>
                        <circle class="dash-kpi-ring-fill" cx="40" cy="40" r="34"
                                stroke-dasharray="{{ circumference }}"
                                stroke-dashoffset="{{ offset }}"/>
                    </svg>
                    <span class="dash-kpi-ring-label">{{ revenue_percent }}%</span>
                </div>
                <div class="dash-kpi-value">
                    {{ annual_revenue|number_format(0, ',', ' ') }}<span>/{{ annual_target|number_format(0, ',', ' ') }} €</span>
                </div>
                <div class="dash-kpi-label">Revenu annuel {{ "now"|date("Y") }}</div>
            </div>
        </div>

        {# KPI 2 — Clients actifs #}
        <div class="dash-kpi">
            <div class="dash-kpi-inner">
                <div class="dash-kpi-ring">
                    <svg viewBox="0 0 80 80">
                        <circle class="dash-kpi-ring-bg" cx="40" cy="40" r="34"/>
                        <circle class="dash-kpi-ring-fill" cx="40" cy="40" r="34"
                                stroke-dasharray="213.6"
                                stroke-dashoffset="0"/>
                    </svg>
                    {# Affichage de la nouvelle variable envoyée par le contrôleur #}
                    <span class="dash-kpi-ring-label">{{ total_clients }}</span>
                </div>
                <div class="dash-kpi-value">Clients actifs</div>
            </div>
        </div>

{# KPI 3 — Projets en cours #}
<div class="dash-kpi">
    <div class="dash-kpi-inner">
        <div class="dash-kpi-ring">
            <svg viewBox="0 0 80 80">
                <circle class="dash-kpi-ring-bg" cx="40" cy="40" r="34"/>
                <circle class="dash-kpi-ring-fill" cx="40" cy="40" r="34"
                        stroke-dasharray="213.6"
                        stroke-dashoffset="0"/>
            </svg>
            <span class="dash-kpi-ring-label">{{ total_projects }}</span>
        </div>
        <div class="dash-kpi-value">Projets en cours</div>
    </div>
</div>

    </div>


    {# ══════════════════════════════════════════════════════
       GESTION DES PROJETS (table)
       ══════════════════════════════════════════════════════ #}
    <div class="dash-card">
<div class="inside-card">
    <div class="dash-card-header">
        <h2 class="dash-card-title">Gestion des projets</h2>
        <a href="{{ path('app_project_index') }}" class="dash-card-link">Tout voir</a>
    </div>

    <div class="table-wrapper">
        <table class="clients-table">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Client</th>
                    <th>Budget</th>
                    <th>Avancement</th>
                    <th>Statut</th>
                    <th>Deadline</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for project in projects %}
                    <tr>
                        <td><strong>{{ project.title }}</strong></td>
                        <td>{{ project.client.companyName }}</td>
                        <td>{{ project.budget|number_format(2, '.', ',') }} €</td>
                        <td>
                            <div class="project-progress-bar">
                                <div class="project-progress-fill" style="width: {{ project.progress }}%"></div>
                            </div>
                            <span class="project-progress-label">{{ project.progress }} %</span>
                        </td>
                        <td>
                            {% set s = project.status %}
                            {% if s == 'en_cours' %}
                                <span class="clients-status project-status--encours">En cours</span>
                            {% elseif s == 'livre' %}
                                <span class="clients-status project-status--livre">Livré</span>
                            {% elseif s == 'paye' %}
                                <span class="clients-status clients-status--actif">Payé</span>
                            {% else %}
                                <span class="clients-status clients-status--attente">{{ project.status }}</span>
                            {% endif %}
                        </td>
                        <td>{{ project.deadline ? project.deadline|date('d/m/Y') : '—' }}</td>
                        <td>
                            <div class="clients-actions">
                                <a href="{{ path('app_project_show', {'id': project.id}) }}" title="Voir">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                </a>
                                <a href="{{ path('app_project_edit', {'id': project.id}) }}" title="Modifier">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="clients-empty">Aucun projet en cours.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
    </div>


    {# ══════════════════════════════════════════════════════
       BOTTOM ROW : Calendrier + Clients
       ══════════════════════════════════════════════════════ #}
    <div class="dash-bottom">

        {# ── Calendrier (FullCalendar mini) ── #}
        <div class="dash-card">
            <div class="inside-card">
            <div class="dash-card-header">
                <h2 class="dash-card-title">Calendrier</h2>
                <a href="{{ path('app_calendar') }}" class="dash-card-link">Voir tout</a>
            </div>

            <div id="dash-calendar" style="min-height: 350px;"></div>

            </div>{# /inside-card #}
        </div>


{# ── Liste Clients ── #}
        <div class="dash-card">
            <div class="inside-card">
            <div class="dash-card-header">
                <h2 class="dash-card-title">Clients</h2>
                <a href="{{ path('app_client_index') }}" class="dash-card-link">Tout voir</a>
            </div>

            <div class="dash-clients-list">
                {% for client in clients %}
                    <a href="{{ path('app_client_show', {'id': client.id}) }}" class="dash-client-item">
                        <div class="dash-client-avatar">{{ client.firstName|first|upper }}{{ client.lastName|first|upper }}</div>
                        <span class="dash-client-name">{{ client.firstName }} {{ client.lastName }}</span>
                    </a>
                {% else %}
                    <p class="text-muted text-sm">Aucun client pour l'instant.</p>
                {% endfor %}
            </div>
            </div>{# /inside-card #}
        </div>

    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <script>
        document.addEventListener('turbo:load', function () {
            const calendarEl = document.getElementById('dash-calendar');
            if (!calendarEl || calendarEl.dataset.initialized) return;
            calendarEl.dataset.initialized = 'true';

            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'listWeek',
                locale: 'fr',
                height: 350,
                headerToolbar: {
                    left: 'prev,next',
                    center: 'title',
                    right: 'listWeek,dayGridMonth'
                },
                buttonText: {
                    listWeek: 'Semaine',
                    month: 'Mois'
                },
                noEventsText: 'Aucun événement cette semaine',
                dayMaxEvents: 3,

                events: function (fetchInfo, successCallback, failureCallback) {
                    fetch('{{ path("app_calendar_events") }}')
                        .then(response => response.json())
                        .then(data => successCallback(data))
                        .catch(err => failureCallback(err));
                },

                eventClick: function (info) {
                    if (info.event.url) {
                        info.jsEvent.preventDefault();
                        window.location.href = info.event.url;
                    }
                }
            });

            calendar.render();
        });
    </script>

    <style>
        /* Mini calendrier dashboard — override FullCalendar */
        #dash-calendar .fc-toolbar-title {
            font-family: var(--font-family);
            font-size: var(--font-size-md) !important;
            font-weight: var(--font-weight-bold);
        }
        #dash-calendar .fc-button-primary {
            background-color: var(--color-primary) !important;
            border-color: var(--color-primary) !important;
            font-family: var(--font-family);
            font-size: var(--font-size-xs) !important;
            padding: 4px 10px !important;
            border-radius: var(--radius-md) !important;
        }
        #dash-calendar .fc-button-primary:hover {
            background-color: #3730A3 !important;
        }
        #dash-calendar .fc-button-primary.fc-button-active {
            background-color: #3730A3 !important;
        }
        #dash-calendar .fc a { color: inherit; text-decoration: none; }
        #dash-calendar .fc-event {
            border: none !important;
            border-radius: 4px !important;
            font-size: 12px !important;
            cursor: pointer;
        }
        #dash-calendar .fc-list-event:hover td {
            background: rgba(67, 66, 202, 0.05) !important;
        }
    </style>
{% endblock %}
